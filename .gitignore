# Só o programa. Modelos, motor, ambientes Python, músicas e testes se baixam/refazem de novo.
/*
!/.gitignore
!/README.md
!/LICENSE
!/docs/
!/instalador/
!/app/
!/memoria-claude/
!/*.cmd
!/*.bat
# ajustes do app (biblioteca de modelos, voz, karaokê, plugins); cache e registros não
!/.dados-app/
/.dados-app/*
!/.dados-app/config.json
!/.dados-app/presets.json
!/.dados-app/karaoke-plugins/
app/node_modules/
*.log
__pycache__/
